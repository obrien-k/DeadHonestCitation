# Local configuration for to_jekyll.py / wizard.py.
# Copy this to .env (gitignored) and set your own values. --repo / --tag override.

# Path to your Jekyll site repo (where _drafts/ and _posts/ live).
DHC_JEKYLL_REPO=~/git/your-jekyll-site

# Source tag injected into each staged post's front matter ("" to inject none).
DHC_SOURCE_TAG=
